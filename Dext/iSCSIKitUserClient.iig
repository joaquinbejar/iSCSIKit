#ifndef iSCSIKitUserClient_h
#define iSCSIKitUserClient_h

#include <DriverKit/IOUserClient.iig>

class iSCSIKitUserClient : public IOUserClient
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;

    virtual kern_return_t
    ExternalMethod(uint64_t selector,
                   IOUserClientMethodArguments * arguments,
                   const IOUserClientMethodDispatch * dispatch,
                   OSObject * target,
                   void * reference) override;

    // Called by the controller when a task lands in the queue.
    virtual void NotifyTaskPending(uint64_t taskID) LOCALONLY;
};

#endif /* iSCSIKitUserClient_h */
